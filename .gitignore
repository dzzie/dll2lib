# Python
__pycache__/
*.pyc

# build intermediates / work dirs
*.obj
*.exp
vbfuse_work/
full_work/
*.pdb
*result.txt
vb6_make.log
*.vbw

# EXE/DLL/LIB are ignored by default (build artifacts) ...
*.exe
*.dll
*.lib
# ... except the committed example inputs + the prebuilt fused exes, which we
#     ship so the demos build without fuss and the results can be analyzed.
!vbfuse/examples/**/*.dll
!vbfuse/examples/**/*.exe
# prebuilt C-example artifacts: the runnable demo + the dll2lib .lib product
!/examples/**/*.exe
!/examples/**/*.lib
# bundled third-party build tool (VB6-LinkAlchemy's VBStatic, MIT)
!tools/VBStatic.exe
# exestuff: prebuilt test inputs + the committed native/p-code stuffed sample
# binaries (for analysis, e.g. vbdec) -- see tests/make_samples.py
!exestuff/tests/corpus*/*.exe
!exestuff/tests/corpus*/*.dll
# ... but not transient test logs / backups / scratch
make.log
*.away
exestuff/tests/corpus*/_*

# local-only tooling (kept in-tree for convenience, never committed)
/private/
